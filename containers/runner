FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

# Update package lists and install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        wget \
        openjdk-17-jdk \
        bash \
        unzip \
        zip \
        ca-certificates \
        file \
        tree  \
        vim && \
    rm -rf /var/lib/apt/lists/*   # Clean up to reduce image size

# For Python Images
# COPY requirements.txt .
# RUN pip install --no-cache-dir -r requirements.txt

# COPY <REPO DIR/FILE> <CONTAINER LOCATION>
# WORKDIR <WORKING DATA LOCATION>

# Install Nextflow (version before DSL2 strict syntax existed - gross)
RUN wget https://github.com/nextflow-io/nextflow/releases/download/v24.10.0/nextflow-24.10.0-dist && \
    mv nextflow-24.10.0-dist /usr/local/bin/nextflow && \
    chmod +x /usr/local/bin/nextflow

ENV NXF_HOME=/opt/nextflow 

RUN mkdir -p /opt/nextflow && \ 
    chmod -R a+rwx /opt/nextflow

